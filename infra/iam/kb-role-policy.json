{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSource",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::team07-kb-source-${ACCOUNT_ID}/docs/*"
    },
    {
      "Sid": "ListSource",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::team07-kb-source-${ACCOUNT_ID}",
      "Condition": { "StringLike": { "s3:prefix": ["docs/*", "docs/"] } }
    },
    {
      "Sid": "Embed",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel"],
      "Resource": "arn:aws:bedrock:ap-northeast-2::foundation-model/amazon.titan-embed-text-v2:0"
    },
    {
      "Sid": "Vectors",
      "Effect": "Allow",
      "Action": ["s3vectors:PutVectors", "s3vectors:GetVectors", "s3vectors:DeleteVectors", "s3vectors:QueryVectors", "s3vectors:GetIndex"],
      "Resource": "arn:aws:s3vectors:ap-northeast-2:${ACCOUNT_ID}:bucket/team07-kb-vectors/index/career-mentor-kb-v1"
    }
  ]
}
