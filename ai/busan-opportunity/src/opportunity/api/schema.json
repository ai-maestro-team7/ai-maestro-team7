{
  "openapi": "3.0.3",
  "info": {
    "title": "BusanOpportunity",
    "description": "부산 채용공고·청년정책 조회 도구 (B 파트)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/agent/postings/{jobPostingId}/alternatives": {
      "get": {
        "summary": "GET /agent/postings/{jobPostingId}/alternatives",
        "description": "수도권 공고와 하는 일이 비슷한 부산 공고를 찾는다. 사용자가 수도권 공고를 말하거나 비교하려 할 때 쓴다. 대안이 없으면 noAlternative=true다. suggestCompare=false면 비교를 권하지 않는다.",
        "operationId": "agent_alternatives_agent_postings__jobPostingId__alternatives_get",
        "parameters": [
          {
            "description": "기준 공고 ID (예: wk24-…, alio-…)",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Jobpostingid",
              "description": "기준 공고 ID (예: wk24-…, alio-…)"
            },
            "name": "jobPostingId",
            "in": "path"
          }
        ],
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentAlternatives"
                }
              }
            }
          }
        }
      }
    },
    "/agent/postings/{jobPostingId}/regional-talent": {
      "get": {
        "summary": "GET /agent/postings/{jobPostingId}/regional-talent",
        "description": "공공기관 공고의 지역인재 전형 해당 가능성을 돌려준다. 사용자가 이전 공공기관·공기업 공고의 지역인재 전형을 물을 때 쓴다. 결과는 '대상일 수 있어요'까지만이고 공고문 확인이 필요하다.",
        "operationId": "agent_regional_talent_agent_postings__jobPostingId__regional_talent_get",
        "parameters": [
          {
            "description": "공고 ID",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Jobpostingid",
              "description": "공고 ID"
            },
            "name": "jobPostingId",
            "in": "path"
          }
        ],
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionalTalentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/postings": {
      "get": {
        "summary": "GET /agent/postings",
        "description": "사용자에게 맞는 채용공고를 찾는다. 사용자가 일자리·채용공고를 물을 때 쓴다. 비슷하게 맞으면 부산 근무 공고를 먼저 돌려준다. 공고는 최대 5개이고 적합도는 3단계 말로만 준다.",
        "operationId": "agent_search_postings_agent_postings_get",
        "parameters": [
          {
            "description": "찾을 직무·회사 낱말. 없으면 희망 직무로 찾는다",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                }
              ],
              "title": "Keyword",
              "description": "찾을 직무·회사 낱말. 없으면 희망 직무로 찾는다",
              "nullable": true
            },
            "name": "keyword",
            "in": "query"
          },
          {
            "description": "ALL(전국) 또는 BUSAN(부산 근무만)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "BUSAN"
              ],
              "title": "Region",
              "description": "ALL(전국) 또는 BUSAN(부산 근무만)",
              "default": "ALL"
            },
            "name": "region",
            "in": "query"
          },
          {
            "description": "돌려받을 공고 수. 최대 5",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1.0
                }
              ],
              "title": "Limit",
              "description": "돌려받을 공고 수. 최대 5",
              "nullable": true
            },
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentFeed"
                }
              }
            }
          }
        }
      }
    },
    "/agent/compare": {
      "get": {
        "summary": "GET /agent/compare",
        "description": "두 공고를 급여·주거비·통근·지역 정책·지역인재 기준으로 나란히 비교한다. 사용자가 두 공고를 견주어 보고 싶어 할 때 쓴다. 값만 나란히 주고 어느 쪽이 낫다고 판정하지 않는다.",
        "operationId": "agent_compare_agent_compare_get",
        "parameters": [
          {
            "description": "기준 공고 ID (보통 수도권 공고)",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Basejobpostingid",
              "description": "기준 공고 ID (보통 수도권 공고)"
            },
            "name": "baseJobPostingId",
            "in": "query"
          },
          {
            "description": "비교할 공고 ID (보통 부산 공고)",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Altjobpostingid",
              "description": "비교할 공고 ID (보통 부산 공고)"
            },
            "name": "altJobPostingId",
            "in": "query"
          }
        ],
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentCompare"
                }
              }
            }
          }
        }
      }
    },
    "/agent/policies": {
      "get": {
        "summary": "GET /agent/policies",
        "description": "사용자가 받을 수 있는 청년 정책과 판정 이유를 단계별로 돌려준다. 지원금·주거·자산 정책을 물을 때 쓴다. guaranteedIfEligible은 자격이 맞으면 받는 지원, selectiveMax는 선정되면 최대 금액이다.",
        "operationId": "agent_policies_agent_policies_get",
        "parameters": [
          {
            "description": "PREPARE(취업 준비), EMPLOYED(취업 후), SETTLE(정착)",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/PolicyStage"
                }
              ],
              "title": "Stage",
              "description": "PREPARE(취업 준비), EMPLOYED(취업 후), SETTLE(정착)",
              "nullable": true
            },
            "name": "stage",
            "in": "query"
          }
        ],
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentPolicies"
                }
              }
            }
          }
        }
      }
    },
    "/agent/policies/search": {
      "get": {
        "summary": "GET /agent/policies/search",
        "description": "청년정책의 내용·자격·신청 방법을 묻는 질문에 쓴다. 원문 근거와 함께 답한다. answered=false면 answer 없이 notice와 relatedPolicies만 준다. 자격은 relatedPolicies의 status를 따른다.",
        "operationId": "agent_search_policies_agent_policies_search_get",
        "parameters": [
          {
            "description": "정책에 관한 사용자 질문 (예: 부산 청년 월세 지원 신청 방법)",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Question",
              "description": "정책에 관한 사용자 질문 (예: 부산 청년 월세 지원 신청 방법)"
            },
            "name": "question",
            "in": "query"
          }
        ],
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          }
        }
      }
    }
  },
